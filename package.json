{
  "name": "next-horde",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run update:build-id && next dev",
    "build": "npm run update:build-id && next build",
    "build:prod": "npm run clean && npm ci && npm run build && npm run install:prod",
    "clean": "rm -rf node_modules",
    "install:prod": "npm install --no-save --os=linux --cpu=x64 --libc=glibc",
    "lint": "eslint app pages e2e scripts test-utils x-build-scripts _types _constants proxy.ts declarations.d.ts next-types.d.ts playwright.config.ts next.config.js jest.config.js eslint.config.mjs ecosystem.config.js .lintstagedrc.js",
    "knip": "knip",
    "pm2:start-prod": "pm2 start ecosystem.config.js --only horde-js",
    "pm2:stop-prod": "pm2 delete ecosystem.config.js --only horde-js",
    "pm2:start-beta": "pm2 start ecosystem.config.js --only artbot-beta",
    "pm2:stop-beta": "pm2 delete ecosystem.config.js --only artbot-beta",
    "start": "NODE_ENV=production next start",
    "update:build-id": "node ./x-build-scripts/updateBuildId.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:generate-library": "npx next build && node e2e/fixtures/generateLibrary.mjs",
    "prepare": "husky",
    "profile:capture": "node scripts/browser-profile/cli.mjs capture",
    "profile:seal": "node scripts/browser-profile/cli.mjs seal",
    "profile:inspect": "node scripts/browser-profile/cli.mjs inspect",
    "profile:run": "node scripts/browser-profile/cli.mjs run",
    "profile:list": "node scripts/browser-profile/cli.mjs list",
    "test:profiles": "node --test scripts/browser-profile/profile.test.mjs",
    "analyze": "next analyze"
  },
  "engines": {
    "npm": ">=9.0.0",
    "node": ">=20.19.5"
  },
  "overrides": {
    "postcss": "$postcss",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.7"
    }
  },
  "dependencies": {
    "@asc0910/exif-library": "github:asc0910/exif-library",
    "@ebay/nice-modal-react": "1.2.13",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@szhsin/react-menu": "4.5.2",
    "@tabler/icons-react": "3.51.0",
    "@tanstack/react-query": "5.105.0",
    "app-root-path": "^3.1.0",
    "browser-image-resizer": "2.4.1",
    "buffer-image-size": "0.6.4",
    "clarinet": "0.12.6",
    "client-zip": "2.4.4",
    "clone-deep": "4.0.1",
    "clsx": "2.0.0",
    "dexie": "4.4.7",
    "dexie-export-import": "4.4.2",
    "dotenv": "16.3.1",
    "fabric": "7.4.0",
    "file-saver": "2.0.5",
    "is-mobile": "4.0.0",
    "isomorphic-dompurify": "2.36.0",
    "jsonwebtoken": "9.0.2",
    "memoizee": "0.4.15",
    "next": "16.4.6",
    "node-localstorage": "2.2.1",
    "react": "19.3.1",
    "react-colorful": "5.6.1",
    "react-dom": "19.3.1",
    "react-dropzone": "14.2.3",
    "react-full-screen": "1.1.1",
    "react-markdown": "10.1.0",
    "react-portal": "4.3.0",
    "react-select": "5.10.2",
    "react-swipeable": "7.0.2",
    "react-textarea-autosize": "8.5.9",
    "react-toastify": "10.0.6",
    "react-tooltip": "5.21.5",
    "react-virtuoso": "4.6.1",
    "sharp": "0.35.5",
    "statery": "0.7.1",
    "styled-components": "6.1.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/clarinet": "0.12.3",
    "@types/clone-deep": "4.0.2",
    "@types/file-saver": "2.0.5",
    "@types/jest": "29.5.5",
    "@types/jsonwebtoken": "9.0.3",
    "@types/memoizee": "0.4.9",
    "@types/node": "20.19.43",
    "@types/node-localstorage": "1.3.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/react-portal": "4.0.4",
    "autoprefixer": "10.4.16",
    "daisyui": "^4.4.24",
    "dexie3": "npm:dexie@3.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "knip": "6.43.0",
    "lint-staged": "16.4.0",
    "postcss": "8.5.32",
    "prettier": "3.1.1",
    "raw-loader": "4.0.2",
    "tailwindcss": "3.4.0",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
